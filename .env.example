# Copy to `.env` and fill in.
# `.env` is gitignored — never commit real credentials.

# --- Required ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- Optional overrides ---

# Ports the MCP subprocesses listen on.
# HOTEL_MCP_PORT=8001
# FLIGHT_MCP_PORT=8002

# Full MCP endpoints the client talks to. Override these to point at
# externally-hosted MCP servers (in which case set AUTOSPAWN_MCP=0).
# HOTEL_MCP_URL=http://127.0.0.1:8001/mcp
# FLIGHT_MCP_URL=http://127.0.0.1:8002/mcp

# Set to 0 to skip auto-spawning MCP subprocesses on FastAPI startup.
# AUTOSPAWN_MCP=1
